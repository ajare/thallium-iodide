{
  "name": "thallium-iodide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && node scripts/copy-static.mjs",
    "start": "node dist/server/index.js",
    "install:local": "node scripts/local-install.mjs install",
    "uninstall:local": "node scripts/local-install.mjs uninstall",
    "dev": "npm run build && tsx watch src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": { "zod": "^3.24.0" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.19.0", "typescript": "^5.7.0" }
}
